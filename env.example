# AI-Kline 环境变量配置示例
# 复制此文件为 .env 并填入实际的配置值

# AI-Kline 模型服务配置（带前缀）
AI_KLINE_API_KEY=your_api_key_here
AI_KLINE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AI_KLINE_MODEL_NAME=qwen-vl-max

# ========== MinIO 对象存储配置（可选）==========
# 如果配置了 MinIO，HTML 图表将存储在 MinIO 中并返回 URL
# 如果未配置，工具将返回错误信息

# ---------- 模式说明 ----------
# 1. 本地模式（非 Docker）：使用 localhost 和默认端口
#    - MINIO_ENDPOINT=localhost
#    - MINIO_PORT=9000
#    - 不需要设置 MINIO_EXTERNAL_*
#
# 2. Docker 模式：需要同时设置内部地址和外部地址
#    - 内部地址（容器间通信）：minio:9000
#    - 外部地址（返回给用户）：localhost:20021
#    - 必须设置 MINIO_EXTERNAL_ENDPOINT 和 MINIO_EXTERNAL_PORT

# ---------- 当前配置：Docker 模式 ----------
# MinIO 内部地址（容器内部通信使用，用于上传文件）
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=ai-kline-charts

# MinIO 外部访问地址（返回给用户的 URL）
# Docker 模式下必需，用于生成用户可访问的 URL
# 如果不设置，会返回内部地址（如 http://minio:9000/...）用户无法访问
MINIO_EXTERNAL_ENDPOINT=localhost
MINIO_EXTERNAL_PORT=20021

# ========== 可选：其他配置 ==========
# DEBUG=false
# LOG_LEVEL=INFO
# MCP_HOST=0.0.0.0
# MCP_PORT=20020

# ========== 配置说明 ==========
# 在 Docker 模式下，确保已设置 MINIO_EXTERNAL_ENDPOINT 和 MINIO_EXTERNAL_PORT
# 这些值会用于生成返回给用户的 URL，确保用户可以访问上传的文件
